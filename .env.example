# Server-side only — read by api/generate.js via process.env.GEMINI_API_KEY.
# Do NOT prefix with VITE_ / NEXT_PUBLIC_ — that would expose the key to the browser bundle.
# Get a key: https://aistudio.google.com/app/apikey
# Set this in Vercel Project Settings → Environment Variables for production.
GEMINI_API_KEY=

# Server-side only — signs the Startup Junction session cookie (api/_lib/session.js).
# Must be >= 32 chars; if missing, all sign-ins fail closed.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local dev: put it in .env.local. Production: Vercel Project Settings → Environment Variables.
SESSION_SECRET=

# --- Google Sheets (roster.js, attendanceSheet.js, sheetsClient.js) — all server-side only ---
# One sheet, one service account, shared by every tab reader: Students (roster.js),
# Attendance (attendanceSheet.js), and ChecklistStatus/SessionProgress/Documents/
# Mentors/MentorAssignments (sheetsClient.js). No per-tab env vars — tab names are
# fixed in each reader's source, matching scripts/setup-startup-junction-tabs.mjs.
# ID from the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit. If unset in dev, the local roster.local.json is used for Students; in production it is required, and every other tab is required.
GOOGLE_SHEET_ID=
# Tab name holding the roster; row 1 headers must include "email" and "password" (optional "name"). Defaults to Students.
GOOGLE_SHEET_TAB=
# Service account "client_email"; share the sheet with this address as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account "private_key" from its JSON key. Paste with literal \n or real newlines, optionally in double quotes.
GOOGLE_PRIVATE_KEY=

# --- Permanent demo account all@example.com (setup scripts only; the app reads the password from the sheet) ---
# Seeded into Students AND Consultees by scripts/setup-startup-junction-tabs.mjs and
# scripts/setup-consulting-tabs.mjs. Needed wherever you RUN those scripts, not in Vercel.
DEMO_ACCOUNT_PASSWORD=

# --- Consulting workspace (scripts/setup-consulting-tabs.mjs only; the app itself needs no new vars) ---
# Login emails for the seeded demo rows. Optional *_PASSWORD; otherwise random ones are generated and printed once.
DEMO_EMAIL=
DEMO_ADMIN_EMAIL=
DEMO_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Server-side only — signs the consulting cn_session cookie (api/_lib/consulting/auth.js). Separate from
# SESSION_SECRET on purpose. >= 32 chars or consulting sign-in fails closed. Set it in Vercel too.
CONSULTING_SESSION_SECRET=
