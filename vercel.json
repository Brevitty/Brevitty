{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/consulting/:path*", "destination": "/api/consulting?p=:path*" },
    { "source": "/api/hub/:path*", "destination": "/api/hub?p=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
